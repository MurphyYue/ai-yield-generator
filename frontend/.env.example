# ──────────────────────────────────────────────────────────────────────────────
# Frontend environment — copy this file to .env.local and fill in real values.
# Do NOT commit .env.local. Only .env.example is tracked.
# ──────────────────────────────────────────────────────────────────────────────

# ─── Public app URL ─────────────────────────────────────────────────────────
# Used by server-side tools (e.g. get_market_data) to call /api/vault-context.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Active chain selector ──────────────────────────────────────────────────
# One of: base | arbitrum
NEXT_PUBLIC_CHAIN=base

# ─── RPC endpoints ──────────────────────────────────────────────────────────
# Client-exposed (NEXT_PUBLIC_*): used by wagmi/viem in the browser.
# Server-only: used by the LangGraph agent's on-chain reads.
NEXT_PUBLIC_BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
NEXT_PUBLIC_ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Legacy Sepolia RPC — still referenced by one hook; keep or remove per usage.
NEXT_PUBLIC_ALCHEMY_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# ─── Deployed vault addresses (per chain) ───────────────────────────────────
NEXT_PUBLIC_BASE_VAULT_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_ARBITRUM_VAULT_ADDRESS=0x0000000000000000000000000000000000000000

# Legacy single-chain vars — referenced by older components. Point them at
# whichever chain matches NEXT_PUBLIC_CHAIN above.
NEXT_PUBLIC_VAULT_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_USDT_ADDRESS=0x0000000000000000000000000000000000000000

# ─── LLM (server-only) ──────────────────────────────────────────────────────
# OpenAI-compatible endpoint. Works with OpenAI, Azure OpenAI, or any proxy
# that exposes /v1/chat/completions.
OPENAI_API_KEY=sk-...
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_API_MODEL=gpt-4o

# ─── PostgreSQL (server-only) ───────────────────────────────────────────────
# Used by LangGraph's PostgresSaver for conversation checkpoints and by the
# agent's alert/conversation tables.
DATABASE_URL=postgresql://vault:vault@localhost:5432/vault

# ─── Ponder indexer (server-only) ───────────────────────────────────────────
# GraphQL endpoint the agent's get_user_history tool queries.
PONDER_GRAPHQL_URL=http://localhost:42069/graphql

# ─── LangSmith tracing (optional) ───────────────────────────────────────────
# Enable for observability during development. Leave LANGSMITH_TRACING=false
# in production unless you've reviewed what gets shipped to LangSmith.
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=lsv2_pt_...
LANGSMITH_PROJECT=web3-vault-agent
