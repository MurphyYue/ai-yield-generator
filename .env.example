# Copy this file to .env and fill in your values.
# NEVER put private keys here. Use: cast wallet import my_deployer_account --interactive

# ─── RPC endpoints ────────────────────────────────────────────────────────────
ANVIL_RPC_URL=http://localhost:8545
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# ─── Block explorer API keys ──────────────────────────────────────────────────
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_KEY
BASESCAN_API_KEY=YOUR_BASESCAN_KEY
ARBISCAN_API_KEY=YOUR_ARBISCAN_KEY

# ─── Deployed contract addresses (fill in after deployment) ──────────────────
USDC_BASE=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
VAULT_BASE=
STRATEGY_BASE=
YOUR_ADDRESS=

USDC_ARB=0xaf88d065e77c8cC2239327C5EDb3A432268e5831
VAULT_ARB=
STRATEGY_ARB=

# ─── Local database ───────────────────────────────────────────────────────────
DATABASE_URL=postgresql://vault:vault@localhost:5432/vault
